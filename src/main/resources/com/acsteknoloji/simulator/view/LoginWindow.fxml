<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="350.0" prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.acsteknoloji.simulator.view.LoginController">
    <children>
        <Label text="Birim Girişi">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <ComboBox fx:id="unitComboBox" prefWidth="200.0" promptText="Birim Seçin..." />
        <PasswordField fx:id="passwordField" maxWidth="200.0" promptText="Şifre" />
        <Button fx:id="loginButton" mnemonicParsing="false" onAction="#onLoginButtonClicked" prefWidth="100.0" text="Giriş Yap" />
        <Label fx:id="statusLabel" textFill="RED" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
