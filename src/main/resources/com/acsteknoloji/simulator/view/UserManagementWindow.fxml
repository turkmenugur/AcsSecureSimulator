<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.acsteknoloji.simulator.view.UserManagementController">
    <children>
        <Label text="Birim Yönetim Paneli">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TableView fx:id="unitsTableView" prefHeight="250.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="unitNameColumn" prefWidth="200.0" text="Birim Adı" />
                <TableColumn fx:id="roleColumn" prefWidth="150.0" text="Rol" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <TitledPane animated="false" text="Yeni Birim Ekle">
            <content>
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Birim Adı:" />
                        <Label text="Parola:" GridPane.rowIndex="1" />
                        <Label text="Rol:" GridPane.rowIndex="2" />
                        <TextField fx:id="newUnitNameField" GridPane.columnIndex="1" />
                        <PasswordField fx:id="newUnitPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <ComboBox fx:id="newUnitRoleComboBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Button fx:id="addUnitButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAddUnitButtonClick" text="Yeni Birim Ekle" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </GridPane>
            </content>
        </TitledPane>
        <TitledPane animated="false" text="Seçili Birim İşlemleri">
            <content>
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Yeni Parola:" />
                                <PasswordField fx:id="resetPasswordField" HBox.hgrow="ALWAYS" />
                                <Button fx:id="resetPasswordButton" mnemonicParsing="false" onAction="#onResetPasswordButtonClick" text="Parolayı Sıfırla" />
                            </children>
                        </HBox>
                        <Button fx:id="deleteUnitButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onDeleteUnitButtonClick" style="-fx-background-color: #E06666;" text="Seçili Birimi Sil" textFill="WHITE" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </TitledPane>
        <Label fx:id="statusLabel" text="Durum: Bekleniyor..." />
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>
