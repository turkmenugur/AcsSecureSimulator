<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.acsteknoloji.simulator.model.Message?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>

<?import javafx.geometry.Insets?>
<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.acsteknoloji.simulator.view.MainWindowController">
   <left>
      <ListView fx:id="unitListView" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </left>
   <right>
       <VBox fx:id="detailsPane" prefWidth="250.0" style="-fx-border-color: #CCCCCC; -fx-background-color: #FAFAFA;">
           <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
           </padding>
           <children>
               <Label fx:id="detailsTitleLabel" text="Mesaj Detayları" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;">
                   <VBox.margin>
                       <Insets bottom="5.0" />
                   </VBox.margin>
               </Label>

               <Label text="Gönderen:" styleClass="details-header-label" />
               <Label fx:id="detailsSenderLabel" styleClass="details-content-label" text="N/A" />

               <Label text="Alıcı:" styleClass="details-header-label" />
               <Label fx:id="detailsReceiverLabel" styleClass="details-content-label" text="N/A" />

               <Label text="Zaman Damgası:" styleClass="details-header-label" />
               <Label fx:id="detailsTimestampLabel" styleClass="details-content-label" text="N/A" />

               <Label text="Durum:" styleClass="details-header-label" />
               <Label fx:id="detailsStatusLabel" styleClass="details-content-label" text="N/A" />

               <Label text="Bütünlük:" styleClass="details-header-label" />
               <Label fx:id="detailsIntegrityLabel" styleClass="details-content-label" text="N/A" />

               <Label text="Şifreli Metin (AES):" styleClass="details-header-label" />
               <TextArea fx:id="detailsEncryptedTextArea" editable="false" prefHeight="100.0" wrapText="true" />

               <Label text="Mesaj Hash (SHA-256):" styleClass="details-header-label" />
               <TextArea fx:id="detailsHashTextArea" editable="false" prefHeight="70.0" wrapText="true" />
           </children>
       </VBox>
   </right>
   <center>
      <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <center>
            <ListView fx:id="messageListView" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
         </center>
          <bottom>
              <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="8.0" style="-fx-border-color: #CCCCCC; -fx-border-width: 1 0 0 0; -fx-background-color: #F9F9F9;" BorderPane.alignment="CENTER">
                  <children>
                      <TextField fx:id="messageTextField" promptText="Mesajınızı yazın..." HBox.hgrow="ALWAYS" />

                      <ComboBox fx:id="commandComboBox" prefWidth="130.0" promptText="Hızlı Komut..." />

                      <Button fx:id="attachFileButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;">
                          <graphic>
                              <FontIcon iconLiteral="fas-paperclip" iconSize="18" iconColor="#555555" />
                          </graphic>
                      </Button>

                      <Button fx:id="sendButton" defaultButton="true" mnemonicParsing="false" onAction="#onSendButtonClick" text="Gönder" contentDisplay="RIGHT" style="-fx-font-weight: bold; -fx-cursor: hand;">
                          <graphic>
                              <FontIcon iconLiteral="fas-paper-plane" iconSize="16" />
                          </graphic>
                      </Button>
                  </children>
                  <padding>
                      <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
                  </padding>
              </HBox>
          </bottom>
      </BorderPane>
   </center>
</BorderPane>
