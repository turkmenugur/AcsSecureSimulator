<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.acsteknoloji.simulator.view.LogViewerController">
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Sistem Aktivite Logları">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                    <children>
                        <VBox>
                            <children>
                                <Label text="Birim Adına Göre Filtrele:" />
                                <TextField fx:id="unitFilterField" promptText="örn: KKM" />
                            </children>
                        </VBox>
                        <VBox>
                            <children>
                                <Label text="Eylem Tipine Göre Filtrele:" />
                                <TextField fx:id="actionFilterField" promptText="örn: LOGIN veya FILE_SENT" />
                            </children>
                        </VBox>
                        <Button fx:id="filterButton" mnemonicParsing="false" onAction="#onFilterButtonClick" text="Filtrele / Yenile" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <TableView fx:id="logsTableView" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="logIdColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="logTimestampColumn" prefWidth="170.0" text="Zaman Damgası" />
                <TableColumn fx:id="unitNameColumn" prefWidth="100.0" text="Birim Adı" />
                <TableColumn fx:id="actionTypeColumn" prefWidth="120.0" text="Eylem Tipi" />
                <TableColumn fx:id="actionDetailsColumn" prefWidth="300.0" text="Eylem Detayı" />
                <TableColumn fx:id="ipAddressColumn" prefWidth="120.0" text="IP Adresi" />
                <TableColumn fx:id="hostnameColumn" prefWidth="120.0" text="Cihaz Adı" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="statusLabel" text="Durum: Loglar yükleniyor..." />
            </children>
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
